{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dango",
  "version": "0.1.0",
  "identifier": "app.dango.editor",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dango",
        "width": 1440,
        "height": 900,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": {
      "../frontend/fonts/ChunkypufflyRegular.otf": "fonts/ChunkypufflyRegular.otf",
      "../.ffmpeg-cache/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "../.ffmpeg-cache/ffprobe.exe": "ffmpeg/ffprobe.exe"
    },
    "windows": {
      "wix": {
        "dialogImagePath": "windows/installer-dialog.bmp",
        "bannerPath": "windows/installer-banner.bmp"
      }
    },
    "icon": [
      "../icons/Dango.ico"
    ]
  }
}
